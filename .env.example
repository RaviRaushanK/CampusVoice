NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/campusvoice
# Required only for tests. Suites create and remove unique databases under this namespace.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/campusvoice_test
# Optional private complaint evidence directory; defaults to uploads/complaints.
# Automated upload tests supply their own isolated directory.
COMPLAINT_UPLOAD_DIR=
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000/api
# Generate a random secret of at least 32 bytes. Never commit real values.
JWT_SECRET=
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Leave at 0 without a reverse proxy. Set the exact trusted proxy hop count otherwise.
TRUST_PROXY_HOPS=0
# Bootstrap only; remove these values after seeding. Email is optional.
PRINCIPAL_NAME=
PRINCIPAL_USER_CODE=
PRINCIPAL_EMAIL=
PRINCIPAL_PASSWORD=
